# =============================================================================
# .gitignore - Protege arquivos sensíveis e desnecessários
# =============================================================================

# ======================== SEGURANÇA ========================
# NUNCA envie arquivos .env com chaves reais para o repositório
.env
.env.local
.env.production
.env.*.local

# ======================== PYTHON (Backend) ========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
venv/
.venv/
env/

# ======================== NODE.JS (Frontend) ========================
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ======================== EDITORES / IDEs ========================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ======================== OS ========================
.DS_Store
desktop.ini
