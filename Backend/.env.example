# Chave de API da Groq (obtenha em https://console.groq.com/keys)
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Modelo LLM padrão
GROQ_MODEL=llama-3.3-70b-versatile

# Configurações do Servidor Backend
PORT=8000
HOST=0.0.0.0
DEBUG=True
